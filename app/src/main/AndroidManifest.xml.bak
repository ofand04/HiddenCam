<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="HiddenCam"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity android:name=".PlaybackActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified" />
        <activity android:name=".FolderVaultActivity" android:exported="false" android:screenOrientation="unspecified" />
        <activity android:name=".RecoveryActivity" android:exported="false" android:screenOrientation="unspecified" />

        <activity-alias
            android:name=".LauncherHiddenCam"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="HiddenCam"
            android:icon="@drawable/ic_launcher"
            android:roundIcon="@drawable/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCalculator"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Calculator"
            android:icon="@drawable/ic_launcher_calculator"
            android:roundIcon="@drawable/ic_launcher_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Notes"
            android:icon="@drawable/ic_launcher_notes"
            android:roundIcon="@drawable/ic_launcher_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="camera"
            android:stopWithTask="false" />
    </application>
</manifest>
